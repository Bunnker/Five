POSTGRES_USER=five
POSTGRES_PASSWORD=five-local-only
POSTGRES_DB=five
POSTGRES_PORT=5432
DATABASE_URL=postgresql://five:five-local-only@localhost:5432/five
HTTP_PORT=3100
FIVE_API_ORIGIN=http://127.0.0.1:3100
FIVE_PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
FIVE_PUBLIC_ASSET_ALLOWED_ORIGINS=https://images.example.com
FIVE_POSTER_QUEUE_CAPACITY=100
FIVE_DEMO_CONTENT=0
WORKER_POLL_INTERVAL_MS=30000
